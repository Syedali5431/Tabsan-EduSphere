@model Tabsan.EduSphere.Web.Models.Portal.PortalCapabilityMatrixPageModel
@{
    ViewData["Title"] = T.Text("Portal Capability Matrix");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@T["Portal Capability Matrix"]</h2>
    <a class="btn btn-outline-secondary" asp-controller="Portal" asp-action="Dashboard">@T["Back to Dashboard"]</a>
</div>

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T.Text(Model.Message)</div>
    return;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@T.Text(Model.Message)</div>
}

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap gap-2">
        <span class="badge @(Model.IncludeUniversity ? "text-bg-success" : "text-bg-secondary")">@T["University"]</span>
        <span class="badge @(Model.IncludeSchool ? "text-bg-success" : "text-bg-secondary")">@T["School"]</span>
        <span class="badge @(Model.IncludeCollege ? "text-bg-success" : "text-bg-secondary")">@T["College"]</span>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>@T["Capability"]</th>
                <th>@T["Module"]</th>
                <th>@T["Route"]</th>
                <th>@T["Active"]</th>
                <th>@T["License"]</th>
                <th>@T["Student"]</th>
                <th>@T["Faculty"]</th>
                <th>@T["Admin"]</th>
                <th>@T["SuperAdmin"]</th>
                <th>@T["University"]</th>
                <th>@T["School"]</th>
                <th>@T["College"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>
                    <div class="fw-semibold">@row.CapabilityName</div>
                    <div class="text-muted small">@row.Description</div>
                </td>
                <td>
                    <div>@row.ModuleName</div>
                    <div class="text-muted small">@row.ModuleKey</div>
                </td>
                <td><code>@row.Route</code></td>
                <td>@(row.IsModuleActive ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.IsLicenseGated ? T.Text("Gated") : T.Text("Open"))</td>
                <td>@(row.Student ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.Faculty ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.Admin ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.SuperAdmin ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.University ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.School ? T.Text("Yes") : T.Text("No"))</td>
                <td>@(row.College ? T.Text("Yes") : T.Text("No"))</td>
            </tr>
        }
        </tbody>
    </table>
</div>
