@model InstitutionPolicyPageModel
@inject Tabsan.EduSphere.Web.Services.IEduApiClient EduApi
@{
    ViewData["Title"] = T.Text("Institution Policy");
}

<h2 class="mb-4">@T["Institution Policy"]</h2>

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["Not connected to API."]</div>
    return;
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@T.Text(ok)</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@T.Text(err)</div>
}
@if (Model.Message != null)
{
    <div class="alert alert-warning">@T.Text(Model.Message)</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <i class="bi bi-building-gear me-2"></i> @T["Active Institution Types"]
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            @T["Enable the institution types your organisation operates."]
            @T["At least one type must remain enabled."]
            @T["Changes take effect immediately for all users."]
        </p>
        @{
            // The portal shows an enabled type only once it has departments (a School-only installation shows no College or University menus).
            var shownTypes = await Tabsan.EduSphere.Web.Services.InstitutionVisibilityExtensions.GetVisibleInstitutionTypesAsync(EduApi, Context, CancellationToken.None);
            var enabledWithoutData = new[] { (Model.IncludeUniversity && !shownTypes.University, "University"), (Model.IncludeSchool && !shownTypes.School, "School"), (Model.IncludeCollege && !shownTypes.College, "College") }
                .Where(t => t.Item1).Select(t => T.Text(t.Item2)).ToList();
        }
        @if (enabledWithoutData.Count > 0)
        {
            <div class="alert alert-info small" data-institution-hidden>
                <i class="bi bi-eye-slash me-1"></i>@T.Format("Hidden until their first department is added: {0}. The portal shows only the enabled institution types that have departments.", string.Join(", ", enabledWithoutData))
            </div>
        }

        <form asp-action="InstitutionPolicy" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="chkUniversity" name="IncludeUniversity" value="true"
                           @(Model.IncludeUniversity ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="chkUniversity">
                        @T["University"]
                    </label>
                    <div class="text-muted small">
                        @T["Semester-based programs with GPA / CGPA tracking."]
                        @T["All existing modules target this mode."]
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="chkSchool" name="IncludeSchool" value="true"
                           @(Model.IncludeSchool ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="chkSchool">
                        @T["School"]
                    </label>
                    <div class="text-muted small">
                        @T["Grade/class-based system (Grades 1–12), streams for Grades 9–12,"]
                        @T["percentage results, and end-of-year promotion."]
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="chkCollege" name="IncludeCollege" value="true"
                           @(Model.IncludeCollege ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="chkCollege">
                        @T["College"]
                    </label>
                    <div class="text-muted small">
                        @T["Year-based academic structure, percentage grading, and year-to-year progression."]
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i> @T["Save Policy"]
            </button>
        </form>
    </div>
</div>
