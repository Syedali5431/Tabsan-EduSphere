@model Tabsan.EduSphere.Web.Models.Portal.ApiConnectionModel
@inject Tabsan.EduSphere.Web.Services.IEduApiClient EduApi
@{
    ViewData["Title"] = T.Text("Dashboard");
    var shownTypes = await Tabsan.EduSphere.Web.Services.InstitutionVisibilityExtensions.GetVisibleInstitutionTypesAsync(EduApi, Context, CancellationToken.None);
    var shownTypeNames = string.Join(" / ", new[] { (shownTypes.School, "School"), (shownTypes.College, "College"), (shownTypes.University, "University") }.Where(t => t.Item1).Select(t => T.Text(t.Item2)));
}

@if (TempData["PortalMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-info ui-toast-source">@T.Text(msg)</div>
}

@* Plan M10: the user's live classes (renders nothing when there are none). *@
@await Component.InvokeAsync("UpcomingLiveClasses")

<section class="dashboard-hero card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="dashboard-hero-grid">
            <div>
                <span class="dashboard-kicker">@T["Campus command center"]</span>
                <h2 class="dashboard-hero-title">@T["A modern workspace for institutional operations"]</h2>
                <p class="dashboard-hero-copy">@T["Manage API connectivity, keep academic workflows in sync, and present a premium SaaS experience across school, college, and university deployments."]</p>
                <div class="dashboard-hero-actions">
                    <a asp-action="TimetableAdmin" class="btn btn-primary">@T["Open Timetable Admin"]</a>
                    <a asp-action="Search" class="btn btn-outline-secondary">@T["Explore Portal Search"]</a>
                </div>
            </div>
            <div class="dashboard-stat-grid">
                <article class="dashboard-stat-card is-primary">
                    <span class="dashboard-stat-label">@T["Workspace status"]</span>
                    <strong class="dashboard-stat-value">@T["Ready"]</strong>
                    <span class="dashboard-stat-meta">@T["Frontend-only redesign active"]</span>
                </article>
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">@T["Deployment fit"]</span>
                    <strong class="dashboard-stat-value">@(shownTypes.School && shownTypes.College && shownTypes.University ? T.Text("School / College / University") : shownTypeNames)</strong>
                    <span class="dashboard-stat-meta">@T["Single premium visual system"]</span>
                </article>
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">@T["Primary theme"]</span>
                    <strong class="dashboard-stat-value">@T["Academic SaaS"]</strong>
                    <span class="dashboard-stat-meta">@T["Clean navigation and card-based layout"]</span>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="dashboard-section mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="section-heading mb-3">
                <div>
                    <span class="section-kicker">@T["Academic readability"]</span>
                    <h2 class="h5 mb-1">@T["Mode quick guide"]</h2>
                    @if (shownTypes.Types.Count > 1)
                    {
                        <p class="text-muted mb-0">@T["Use this as a quick visual reference while switching between School, College, and University operational flows."]</p>
                    }
                </div>
            </div>
            <div class="row g-3">
                @if (shownTypes.School)
                {
                <div class="col-12 col-lg-4">
                    <article class="dashboard-stat-card h-100">
                        <span class="dashboard-stat-label">@T["School mode"]</span>
                        <strong class="dashboard-stat-value">@T["Class 1 to 10"]</strong>
                        <span class="dashboard-stat-meta">@T["Class-period labels and final-marks-friendly result flow"]</span>
                    </article>
                </div>
                }
                @if (shownTypes.College)
                {
                <div class="col-12 col-lg-4">
                    <article class="dashboard-stat-card h-100">
                        <span class="dashboard-stat-label">@T["College mode"]</span>
                        <strong class="dashboard-stat-value">@T["Class 11 to 12"]</strong>
                        <span class="dashboard-stat-meta">@T["Class-based progression with simplified aggregation semantics"]</span>
                    </article>
                </div>
                }
                @if (shownTypes.University)
                {
                <div class="col-12 col-lg-4">
                    <article class="dashboard-stat-card h-100">
                        <span class="dashboard-stat-label">@T["University mode"]</span>
                        <strong class="dashboard-stat-value">@T["Semester/Year"]</strong>
                        <span class="dashboard-stat-meta">@T["GPA/CGPA path retained with semester/year flexibility"]</span>
                    </article>
                </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="dashboard-section">
    <div class="row g-4 align-items-stretch">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 p-lg-5">
                    <div class="section-heading mb-4">
                        <div>
                            <span class="section-kicker">@T["Connection settings"]</span>
                            <h2 class="h4 mb-2">@T["API connection"]</h2>
                            <p class="text-muted mb-0">@T["Set the API base URL, a valid JWT access token, and an optional default department for timetable views."]</p>
                        </div>
                        <div class="section-badge">@T["Secure setup"]</div>
                    </div>

                    <form asp-action="SaveConnection" method="post" class="row g-4 ui-form-grid">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label asp-for="ApiBaseUrl" class="form-label">@T["API Base URL"]</label>
                            <input asp-for="ApiBaseUrl" class="form-control" placeholder="https://api.yourdomain.com" />
                        </div>
                        <div class="col-12">
                            <label asp-for="AccessToken" class="form-label">@T["Access Token (JWT)"]</label>
                            <textarea asp-for="AccessToken" rows="5" class="form-control" placeholder="Paste bearer token here"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DefaultDepartmentId" class="form-label">@T["Default Department Id"]</label>
                            <input asp-for="DefaultDepartmentId" class="form-control" placeholder="@T["Optional"]" />
                        </div>
                        <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="btn btn-primary">@T["Save Connection"]</button>
                            <a asp-action="TimetableAdmin" class="btn btn-outline-secondary">@T["Go To Timetable Admin"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm h-100 dashboard-side-panel">
                <div class="card-body p-4">
                    <span class="section-kicker">@T["Operational checklist"]</span>
                    <h3 class="h5 mb-3">@T["What this page supports"]</h3>
                    <ul class="dashboard-checklist list-unstyled mb-4">
                        <li>@T["Clean credential entry with stronger visual hierarchy"]</li>
                        <li>@T["Card-based layout aligned to the new design system"]</li>
                        <li>@T["Responsive controls optimized for desktop and mobile"]</li>
                        <li>@T["Preserved submission flow and existing backend endpoints"]</li>
                    </ul>
                    <div class="dashboard-note">
                        <strong>@T["Design note"]</strong>
                        <p class="mb-0">@T["This redesign improves shell polish, dashboard presentation, tables, forms, alerts, and chatbot styling without changing business behavior."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
