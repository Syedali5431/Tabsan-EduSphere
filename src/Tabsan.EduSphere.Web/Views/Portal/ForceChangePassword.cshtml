@model Tabsan.EduSphere.Web.Models.Portal.ForceChangePasswordPageModel
@{
    ViewData["Title"] = T.Text("Force Change Password");
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">@T["Change your password"]</h1>
                <p class="text-muted small mb-4">
                    @T["Your account requires a password update before you can continue."]
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-warning">@T.Text(Model.Message)</div>
                }

                <form asp-action="ForceChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">@T["Old Password"]</label>
                        <input id="currentPassword" name="currentPassword" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label">@T["New Password"]</label>
                        <input id="newPassword" name="newPassword" type="password" class="form-control" required />
                    </div>

                    <div class="alert alert-light border small" role="alert">
                        @T["Password rules:"]
                        <ul class="mb-0 mt-2 ps-3">
                            <li>@T["Use 12-16 characters."]</li>
                            <li>Include uppercase, lowercase, number, and symbol (! @@ # $ % ^ &amp; *).</li>
                            <li>@T["Avoid simple patterns like 123456, password, or qwerty."]</li>
                        </ul>
                    </div>

                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label">@T["Confirm Password"]</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">@T["Update Password"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
