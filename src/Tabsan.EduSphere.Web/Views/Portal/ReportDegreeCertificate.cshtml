@model Tabsan.EduSphere.Web.Models.Portal.ReportDegreeCertificatePageModel
@{
    ViewData["Title"] = T.Text("Degree Certificate");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="ReportCenter" asp-controller="Portal" class="btn btn-sm btn-outline-secondary me-3" aria-label="@T["Report Center"]"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-award me-2"></i>@T["Degree Certificate"]</h2>
            <small class="text-muted">@T["Generate a formal degree certificate for graduated students"]</small>
        </div>
    </div>

    @if (!Model.IsConnected)
    {
        <div class="alert alert-warning"><i class="bi bi-wifi-off me-2"></i>@T["Not connected to API."]</div>
    }
    else
    {
        if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@T.Text(Model.Message)</div>
        }

        <form method="get" class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label small mb-1">@T["Graduated Student"]</label>
                        <select aria-label="@T["Graduated Student"]" name="studentProfileId" class="form-select form-select-sm">
                            <option value="">@T["Select a graduated student…"]</option>
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.Id" selected="@(Model.StudentProfileId == s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search me-1"></i>@T["Select Student"]</button>
                    </div>
                </div>
            </div>
        </form>

        @if (Model.StudentProfileId.HasValue)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-award-fill text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="mb-3">@T["Degree Certificate Ready"]</h4>
                    <p class="text-muted mb-4">
                        @T["A formal university degree certificate will be generated as a PDF."]<br />
                        @T["The certificate includes the university seal, student name, degree title, CGPA, and official signatures."]
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="@Url.Action("ExportDegreeCertificatePdf", "Portal", new { studentProfileId = Model.StudentProfileId })"
                           class="btn btn-danger btn-lg px-4">
                            <i class="bi bi-filetype-pdf me-2"></i>@T["Generate &amp; Download Certificate (PDF)"]
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>@T["Certificate Preview"]</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>@T["University:"]</strong> @T["Tabsan University"]</p>
                            <p><strong>@T["Faculty:"]</strong> @T["Faculty of Information Technology"]</p>
                            <p><strong>@T["Degree Level:"]</strong> @T["Bachelor"]</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>@T["Format:"]</strong> @T["A4 Landscape"]</p>
                            <p><strong>@T["Styling:"]</strong> @T["Formal university degree with seal, signatures, gold accents"]</p>
                            <p><strong>@T["Includes:"]</strong> @T["Student name, degree title, CGPA, duration, FYP title, certificate number"]</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-check" style="font-size: 3rem;"></i>
                <p class="mt-3">@T["Select a graduated student above to generate their degree certificate."]</p>
            </div>
        }
    }
</div>
