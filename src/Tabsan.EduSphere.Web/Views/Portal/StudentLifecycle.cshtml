@model Tabsan.EduSphere.Web.Models.Portal.StudentLifecyclePageModel
@inject Tabsan.EduSphere.Web.Services.IEduApiClient EduApi
@{
    ViewData["Title"] = T.Text("Student Lifecycle");
    var shownTypes = await Tabsan.EduSphere.Web.Services.InstitutionVisibilityExtensions.GetVisibleInstitutionTypesAsync(EduApi, Context, CancellationToken.None);
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@T.Text(Model.Message)</div>
}

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["Not connected."] <a asp-action="Dashboard">@T["Configure API"]</a>.</div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" asp-action="StudentLifecycle" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">@T["Institution"]</label>
                    <select aria-label="@T["Institution"]" name="institutionType" class="form-select" onchange="resetStudentFiltersAndSubmit(this.form)">
                        <option value="">@T["All"]</option>
                        @if (shownTypes.University)
                        {
                            <option value="0" selected="@(Model.SelectedInstitutionType == 0 ? "selected" : null)">@T["University"]</option>
                        }
                        @if (shownTypes.School)
                        {
                            <option value="1" selected="@(Model.SelectedInstitutionType == 1 ? "selected" : null)">@T["School"]</option>
                        }
                        @if (shownTypes.College)
                        {
                            <option value="2" selected="@(Model.SelectedInstitutionType == 2 ? "selected" : null)">@T["College"]</option>
                        }
                    </select>
                </div>
                @if (Model.Identity?.IsSuperAdmin == true)
                {
                    <div class="col-md-2">
                        <label class="form-label">@T["Tenant"]</label>
                        <select aria-label="@T["Tenant"]" name="tenantId" class="form-select" onchange="this.form.submit()">
                            <option value="">@T["All Tenants"]</option>
                            @foreach (var t in Model.Tenants)
                            {
                                <option value="@t.Id" selected="@(Model.SelectedTenantId == t.Id ? "selected" : null)">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@T["Campus"]</label>
                        <select aria-label="@T["Campus"]" name="campusId" class="form-select" onchange="this.form.submit()" @(Model.SelectedTenantId.HasValue ? null : "disabled")>
                            <option value="">@T["All Campuses"]</option>
                            @foreach (var c in Model.Campuses)
                            {
                                <option value="@c.Id" selected="@(Model.SelectedCampusId == c.Id ? "selected" : null)">@c.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-2">
                    <label class="form-label">@T["Department"]</label>
                    <select aria-label="@T["Department"]" name="departmentId" class="form-select" onchange="this.form.submit()">
                        <option value="">@T["Select…"]</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Id" selected="@(Model.SelectedDepartmentId == d.Id ? "selected" : null)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@T.Text(Model.PeriodLabel)</label>
                    <select aria-label="@T.Text(Model.PeriodLabel)" name="semester" class="form-select" onchange="this.form.submit()">
                        @for (int i = Model.MinAcademicLevel; i <= Model.MaxAcademicLevel; i++)
                        {
                            <option value="@i" selected="@(Model.SelectedSemester == i ? "selected" : null)">@i</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" id="lifecycleTabs">
        @if (Model.ShowGraduationSection)
        {
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabGrad">
                    @T["Graduation Candidates"]
                    <span class="badge bg-danger ms-1">@Model.GraduationCandidates.Count</span>
                </button>
            </li>
        }
        <li class="nav-item">
            <button class="nav-link @(Model.ShowGraduationSection ? null : "active")" data-bs-toggle="tab" data-bs-target="#tabSem">
                @T.Format("{0} Students", T.Text(Model.PeriodLabel))
                <span class="badge bg-secondary ms-1">@Model.StudentsBySemester.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @if (Model.ShowGraduationSection)
        {
            <div class="tab-pane fade show active" id="tabGrad">
                @if (Model.GraduationCandidates.Count == 0)
                {
                    <p class="text-muted">@T["No graduation candidates in this department."]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>@T["Reg. No."]</th>
                                    <th>@T["Name"]</th>
                                    <th>@T["Program"]</th>
                                    <th>CGPA</th>
                                    <th>@T["Action"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.GraduationCandidates)
                                {
                                    <tr>
                                        <td><code>@s.RegistrationNumber</code></td>
                                        <td>@s.FullName</td>
                                        <td>@s.ProgramName</td>
                                        <td>@(s.Cgpa.HasValue ? s.Cgpa.Value.ToString("0.00") : "–")</td>
                                        <td>
                                            <form asp-action="GraduateStudent" method="post" class="d-inline">
                                                <input type="hidden" name="studentId" value="@s.Id" />
                                                <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                                                <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
                                                <input type="hidden" name="campusId" value="@Model.SelectedCampusId" />
                                                <button type="submit" class="btn btn-success btn-sm"
                                                        onclick="return confirm('@T.Js("Graduate this student?")')">
                                                    @T["Graduate"]
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <div class="tab-pane fade @(Model.ShowGraduationSection ? null : "show active")" id="tabSem">
            @if (Model.StudentsBySemester.Count == 0)
            {
                <p class="text-muted">@T.Format("No students in selected department / {0}.", T.Text(Model.PeriodLabel).ToLowerInvariant())</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr><th>@T["Reg. No."]</th><th>@T["Name"]</th><th>@T.Text(Model.PeriodLabel)</th><th>@T["Action"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.StudentsBySemester)
                            {
                                <tr>
                                    <td><code>@s.RegistrationNumber</code></td>
                                    <td>@s.FullName</td>
                                    <td>@s.SemesterNumber</td>
                                    <td>
                                        <form asp-action="PromoteStudent" method="post" class="d-inline">
                                            <input type="hidden" name="studentId" value="@s.Id" />
                                            <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                                            <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
                                            <input type="hidden" name="campusId" value="@Model.SelectedCampusId" />
                                            <input type="hidden" name="semester" value="@Model.SelectedSemester" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm"
                                                    onclick="return confirm('@T.Js("Promote this student?")')">
                                                @T["Promote"]
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<script>
    function resetStudentFiltersAndSubmit(form) {
        form.querySelector('select[name="tenantId"]').value = '';
        form.querySelector('select[name="campusId"]').value = '';
        form.querySelector('select[name="departmentId"]').value = '';
        form.querySelector('select[name="semester"]').value = '1';
        form.submit();
    }
</script>

