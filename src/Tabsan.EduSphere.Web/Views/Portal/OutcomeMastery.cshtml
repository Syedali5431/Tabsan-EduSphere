@model Tabsan.EduSphere.Web.Models.Portal.OutcomeMasteryPageModel
@{
    ViewData["Title"] = T.Text("Learning Mastery Gradebook");
    var g = Model.Gradebook;
    string Css(string status) => status switch { "mastered" => "mastery-ok", "near" => "mastery-near", "below" => "mastery-below", _ => "mastery-none" };
    string StatusText(string status) => status switch { "mastered" => "Mastered", "near" => "Near mastery", "below" => "Below mastery", _ => "No evidence" };
}
<style>
    .mastery-grid th, .mastery-grid td { white-space: nowrap; }
    .mastery-grid .sticky-col { position: sticky; left: 0; background: var(--bs-body-bg, #fff); z-index: 1; }
    .mastery-cell { text-align: center; font-variant-numeric: tabular-nums; }
    .mastery-grid > tbody > tr > td.mastery-ok { background-color: #d1e7dd; color: #0f5132; box-shadow: none; }
    .mastery-grid > tbody > tr > td.mastery-near { background-color: #fff3cd; color: #664d03; box-shadow: none; }
    .mastery-grid > tbody > tr > td.mastery-below { background-color: #f8d7da; color: #842029; box-shadow: none; }
    .mastery-key .mastery-ok { background: #d1e7dd; color: #0f5132; }
    .mastery-key .mastery-near { background: #fff3cd; color: #664d03; }
    .mastery-key .mastery-below { background: #f8d7da; color: #842029; }
    .mastery-none { color: #6c757d; }
    .mastery-key span { display: inline-block; padding: .1rem .5rem; border-radius: .25rem; margin-right: .35rem; }
</style>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@T.Text(Model.Message)</div>
}

<div class="d-flex flex-wrap align-items-start gap-2 mb-3">
    <div class="me-auto">
        <h2 class="h3 mb-1">@T["Learning Mastery Gradebook"]</h2>
        <p class="text-muted mb-0">@T["Each student's mastery of the outcomes assessed in a course, from posted grades and finished quizzes."]</p>
    </div>
    <a asp-action="Outcomes" class="btn btn-sm btn-outline-secondary">@T["Outcomes"]</a>
</div>

@if (!Model.IsConnected)
{
    <div class="border rounded p-3 bg-light">@T["API connection is not configured."]</div>
}
else if (Model.ModuleOff)
{
    <div class="border border-warning rounded p-3 bg-light" data-outcomes-module-off><strong>@T["The Learning Outcomes module is not active."]</strong> @T["Activate it in"] <a asp-action="ModuleComposition">@T["Module Composition"]</a>.</div>
}
else
{
    <form method="get" asp-action="OutcomeMastery" class="row g-2 align-items-end mb-3">
        <div class="col-md-6">
            <label class="form-label small" for="m-offering">@T["Course"]</label>
            <select id="m-offering" name="offeringId" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var o in Model.Offerings) { <option value="@o.Id" selected="@(o.Id == Model.OfferingId)">@o.Name</option> }
            </select>
        </div>
        <div class="col-md-6 d-flex gap-2 justify-content-md-end">
            <noscript><button class="btn btn-sm btn-outline-secondary">@T["Show"]</button></noscript>
            @if (g is not null)
            {
                <a asp-action="OutcomeMasteryExport" asp-route-offeringId="@Model.OfferingId" class="btn btn-sm btn-outline-primary">@T["Export to Excel"]</a>
            }
        </div>
    </form>
    @if (g is not null)
    {
        <form asp-action="RecalculateOutcomes" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="offeringId" value="@Model.OfferingId" />
            <button class="btn btn-sm btn-link px-0">@T["Recalculate from the current grades"]</button>
        </form>
    }

    @if (g is null && Model.Offerings.Count == 0)
    {
        <p class="text-muted">@T["You have no course offerings."]</p>
    }
    else if (g is null)
    {
        <div class="border border-warning rounded p-3 bg-light" data-mastery-error>@(Model.Message ?? T.Text("The gradebook could not be loaded."))</div>
    }
    else if (g.Outcomes.Count == 0)
    {
        <div class="border rounded p-3 bg-light" data-mastery-empty>
            @T.Format("No outcomes are assessed in {0} yet. Add course outcomes on the", g.CourseCode) <a asp-action="Outcomes">@T["Learning Outcomes"]</a> @T["page, then use the"]
            <strong>@T["Outcomes"]</strong> @T["button on rubric criteria, quiz questions or assignment settings to align them."]
        </div>
    }
    else if (g is not null)
    {
        <p class="small mastery-key mb-2" aria-hidden="true">
            <span class="mastery-ok">@T["Mastered"]</span><span class="mastery-near">@T["Near mastery"]</span><span class="mastery-below">@T["Below mastery"]</span><span class="mastery-none border">@T["— no evidence"]</span>
        </p>
        <div class="table-responsive border rounded">
            <table class="table table-sm mb-0 mastery-grid" data-mastery-grid>
                <caption class="visually-hidden">@T.Format("Mastery of each outcome by student in {0} {1}", g.CourseCode, g.CourseTitle)</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="sticky-col">@T["Student"]</th>
                        @foreach (var o in g.Outcomes)
                        {
                            <th scope="col" class="text-center" title="@o.Title">
                                <div>@o.Code</div>
                                <div class="small fw-normal text-muted">@T.Format("mastery {0}/{1}", o.MasteryPoints.ToString("0.##"), o.MaxPoints.ToString("0.##"))</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in g.Students)
                    {
                        <tr>
                            <th scope="row" class="sticky-col fw-normal">@s.Name <span class="small text-muted">@s.RegistrationNumber</span></th>
                            @for (var i = 0; i < s.Cells.Count; i++)
                            {
                                var c = s.Cells[i];
                                <td class="mastery-cell @Css(c.Status)" data-status="@c.Status" title="@(c.Rating ?? StatusText(c.Status))@(c.Evidence > 0 ? $" · {c.Evidence} assessment(s)" : "")">
                                    @(c.Score?.ToString("0.##") ?? "—")<span class="visually-hidden"> @StatusText(c.Status)</span>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th scope="row" class="sticky-col">@T["Mastered"]</th>
                        @foreach (var o in g.Outcomes)
                        {
                            <td class="text-center small">@T.Format("{0} of {1}", o.MasteredCount, o.AssessedCount)</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
        <details class="mt-3 small">
            <summary>@T["Outcomes in this gradebook"]</summary>
            <ul class="mb-0 mt-1">
                @foreach (var o in g.Outcomes) { <li><strong>@o.Code</strong> (@o.Level) @o.Title</li> }
            </ul>
        </details>
    }
}
