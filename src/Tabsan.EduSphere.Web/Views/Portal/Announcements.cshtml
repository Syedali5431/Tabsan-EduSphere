@model Tabsan.EduSphere.Web.Models.Portal.AnnouncementsPageModel
@{
    ViewData["Title"]     = T.Text("Announcements");
    ViewData["PageTitle"] = T.Text("Course Announcements");
    ViewData["ActivePage"] = "announcements";
}

@* Final-Touches Phase 20 Stage 20.4 — course announcements page *@

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["API is not available."]</div>
    return;
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @T.Text(Model.SuccessMessage) <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @T.Text(Model.ErrorMessage) <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}

<form method="get" asp-action="Announcements" class="row g-2 align-items-end mb-4"
      data-cascade-filter data-filter-role="@(User.IsInRole("SuperAdmin") ? "SuperAdmin" : User.IsInRole("Admin") ? "Admin" : User.IsInRole("Faculty") ? "Faculty" : "Student")">
    <partial name="_InstitutionFilter" />
    @if (User.IsInRole("SuperAdmin"))
    {
        <div class="col-md-3">
            <label class="form-label">@T["Tenant"]</label>
            <select aria-label="@T["Tenant"]" name="tenantId" class="form-select" onchange="this.form.submit()">
                <option value="">@T["All Tenants"]</option>
                @foreach (var t in Model.Tenants)
                {
                    <option value="@t.Id" selected="@(Model.SelectedTenantId == t.Id ? "selected" : null)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">@T["Campus"]</label>
            <select aria-label="@T["Campus"]" name="campusId" class="form-select" onchange="this.form.submit()" @(Model.SelectedTenantId.HasValue ? null : "disabled")>
                <option value="">@T["All Campuses"]</option>
                @foreach (var c in Model.Campuses)
                {
                    <option value="@c.Id" selected="@(Model.SelectedCampusId == c.Id ? "selected" : null)">@c.Name</option>
                }
            </select>
        </div>
    }
    else if (User.IsInRole("Admin"))
    {
        <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
        <div class="col-md-3">
            <label class="form-label">@T["Campus"]</label>
            <select aria-label="@T["Campus"]" name="campusId" class="form-select" onchange="this.form.submit()">
                <option value="">@T["All Campuses"]</option>
                @foreach (var c in Model.Campuses)
                {
                    <option value="@c.Id" selected="@(Model.SelectedCampusId == c.Id ? "selected" : null)">@c.Name</option>
                }
            </select>
        </div>
    }
    else if (!User.IsInRole("Student"))
    {
        <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
        <input type="hidden" name="campusId" value="@Model.SelectedCampusId" />
    }
    <div class="col-md-3">
        <label class="form-label">@T["Department"]</label>
        <select aria-label="@T["Department"]" name="departmentId" class="form-select" onchange="this.form.submit()">
            <option value="">@T["All Departments"]</option>
            @foreach (var d in Model.Departments)
            {
                <option value="@d.Id" selected="@(Model.SelectedDepartmentId == d.Id ? "selected" : null)">@d.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">@T["Course Offering"]</label>
        @if (Model.Offerings.Any())
        {
            var hasCurrentOffering = Model.Offerings.Any(o => o.Id == Model.OfferingId);
            <select aria-label="@T["Course Offering"]" name="offeringId" class="form-select" onchange="this.form.submit()">
                <option value="">@T["All Offerings in Selected Department"]</option>
                @if (!hasCurrentOffering && Model.OfferingId != System.Guid.Empty)
                {
                    <option value="@Model.OfferingId" selected="selected">@T.Format("Current offering ({0})", Model.OfferingId)</option>
                }
                @foreach (var o in Model.Offerings)
                {
                    <option value="@o.Id" selected="@(Model.OfferingId == o.Id ? "selected" : null)">@o.Name</option>
                }
            </select>
        }
        else
        {
            <input class="form-control" value="@T.Text("No offerings available for the selected scope")" aria-label="@T["Course Offering"]" readonly />
        }
    </div>
    <div class="col-md-2">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" @(Model.IncludeInactive ? "checked" : null) onchange="this.form.submit()" />
            <label class="form-check-label" for="includeInactive">@T["Show inactive"]</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">@T["Apply"]</button>
    </div>
</form>

<div class="card mb-4">
    <div class="card-header"><strong>@T["Post Announcement"]</strong></div>
    <div class="card-body">
        <form asp-action="CreateAnnouncement" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="offeringId" value="@(Model.OfferingId == System.Guid.Empty ? null : Model.OfferingId)" />
            <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
            <input type="hidden" name="includeInactive" value="@Model.IncludeInactive" />
            <div class="mb-2">
                <input name="title" class="form-control" placeholder="@T["Announcement title..."]" required />
            </div>
            <div class="mb-2">
                <textarea name="body" class="form-control" rows="3" placeholder="Message..." required></textarea>
            </div>
            <div class="form-text mb-2">
                @if (Model.OfferingId != System.Guid.Empty)
                {
                    <span>@T["This announcement will be posted to the selected course offering."]</span>
                }
                else if (Model.SelectedDepartmentId.HasValue)
                {
                    <span>@T["This announcement will be posted to all offerings in the selected department."]</span>
                }
                else
                {
                    <span>@T["Select a department or offering above before posting."]</span>
                }
            </div>
            <button type="submit" class="btn btn-primary">@T["Post"]</button>
        </form>
    </div>
</div>

@if (!Model.Announcements.Any())
{
    <div class="alert alert-info">@T["No announcements for the selected scope."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@T["Title"]</th>
                    <th>@T["Message"]</th>
                    <th>@T["Author"]</th>
                    <th>@T["Posted"]</th>
                    <th>@T["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Announcements)
                {
                    <tr>
                        <td class="fw-semibold">@a.Title@if (a.Ids.Count > 1) { <span class="badge bg-info-subtle text-info-emphasis ms-1" title="@T["Department-wide announcement"]">@T.Format("{0} offerings", a.Ids.Count)</span> }</td>
                        <td>@a.Body</td>
                        <td>@a.AuthorName</td>
                        <td class="text-muted">@a.PostedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(a.IsActive ? "bg-success" : "bg-secondary")">@(a.IsActive ? T.Text("Active") : T.Text("Inactive"))</span>
                        </td>
                        <td class="text-nowrap">
                            @if (Model.CanManage)
                            {
                                <form asp-action="SetAnnouncementActive" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="announcementId" value="@a.Id" />
                                    @foreach (var copyId in a.Ids) { <input type="hidden" name="announcementIds" value="@copyId" /> }
                                    <input type="hidden" name="offeringId" value="@(Model.OfferingId == System.Guid.Empty ? null : Model.OfferingId)" />
                                    <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                                    <input type="hidden" name="includeInactive" value="@Model.IncludeInactive" />
                                    <input type="hidden" name="isActive" value="@(!a.IsActive ? "true" : "false")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        @(a.IsActive ? T.Text("Deactivate") : T.Text("Activate"))
                                    </button>
                                </form>
                                <form asp-action="DeleteAnnouncement" method="post" class="d-inline" onsubmit="return confirm('@T.Js("Delete this announcement?")')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="announcementId" value="@a.Id" />
                                    @foreach (var copyId in a.Ids) { <input type="hidden" name="announcementIds" value="@copyId" /> }
                                    <input type="hidden" name="offeringId" value="@(Model.OfferingId == System.Guid.Empty ? null : Model.OfferingId)" />
                                    <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                                    <input type="hidden" name="includeInactive" value="@Model.IncludeInactive" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["Delete"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
