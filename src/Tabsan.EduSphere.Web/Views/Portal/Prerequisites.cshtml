@model PrerequisitesPageModel
@using Tabsan.EduSphere.Web.Models.Portal
@{
    ViewData["Title"] = "Course Prerequisites";
    Layout = "_Layout";
}

@* Final-Touches Phase 15 Stage 15.1 — Prerequisites view: Admin/SuperAdmin manage course prerequisites *@

<div class="container-fluid">
    <h4 class="mb-3">Course Prerequisites</h4>
    <p class="text-muted">Define which courses a student must pass before they can enroll in another course.</p>

    @if (Model.Message != null)
    {
        var alertClass = Model.Message.StartsWith("Error") ? "alert-danger" : "alert-success";
        <div class="alert @alertClass alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Department filter *@
    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @foreach (var d in Model.Departments)
                {
                    <option value="@d.Id" selected="@(Model.SelectedDepartmentId == d.Id ? "selected" : null)">@d.Name</option>
                }
            </select>
        </div>
    </form>

    @foreach (var group in Model.CourseGroups)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><strong>@group.CourseCode</strong> — @group.CourseTitle</span>
                <span class="badge bg-secondary">@group.Prerequisites.Count prerequisite(s)</span>
            </div>
            <div class="card-body">
                @if (group.Prerequisites.Any())
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var prereq in group.Prerequisites)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@prereq.PrerequisiteCourseCode — @prereq.PrerequisiteCourseTitle</span>
                                <form method="post" asp-action="PrerequisiteRemove" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@group.CourseId" />
                                    <input type="hidden" name="prerequisiteCourseId" value="@prereq.PrerequisiteCourseId" />
                                    <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Remove this prerequisite?')">Remove</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-2">No prerequisites defined.</p>
                }

                @* Opens the shared "Add Prerequisite" modal below, scoped to this course via data attributes. *@
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#addPrerequisiteModal"
                        data-course-id="@group.CourseId"
                        data-course-label="@group.CourseCode — @group.CourseTitle">
                    Add Prerequisite
                </button>
            </div>
        </div>
    }

    @if (!Model.CourseGroups.Any())
    {
        <div class="alert alert-info">No courses found. Select a department to filter.</div>
    }
</div>

@* Single shared "Add Prerequisite" modal, reused by every course card above.
   Rendering one full course dropdown here (instead of once per course row, as before)
   avoids an O(n²) blow-up: with 174 courses that was ~30,000 <option> elements and a 4MB page. *@
<div class="modal fade" id="addPrerequisiteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="PrerequisiteAdd">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" id="addPrerequisiteCourseId" value="" />
                <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                <div class="modal-header">
                    <h5 class="modal-title">Add prerequisite for <span id="addPrerequisiteCourseLabel"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="addPrerequisiteCourseSelect" class="form-label fw-semibold">Prerequisite course</label>
                    <select name="prerequisiteCourseId" id="addPrerequisiteCourseSelect" class="form-select" required>
                        <option value="">— Select prerequisite course —</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.Id">@c.Code — @c.Title</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Prerequisite</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('addPrerequisiteModal');
        if (!modal) return;
        modal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var courseId = button.getAttribute('data-course-id') || '';
            var courseLabel = button.getAttribute('data-course-label') || '';
            document.getElementById('addPrerequisiteCourseId').value = courseId;
            document.getElementById('addPrerequisiteCourseLabel').textContent = courseLabel;

            var select = document.getElementById('addPrerequisiteCourseSelect');
            select.value = '';
            Array.from(select.options).forEach(function (opt) {
                opt.hidden = opt.value !== '' && opt.value === courseId;
            });
        });
    });
</script>
