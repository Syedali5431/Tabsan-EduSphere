                <input type="hidden" name="semesterName" value="@Model.SelectedSemesterName" />
                <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
                <input type="hidden" name="campusId" value="@Model.SelectedCampusId" />
                <input type="hidden" name="departmentId" value="@Model.SelectedDepartmentId" />
                <input type="hidden" name="courseId" value="@Model.SelectedCourseId" />
                <input type="hidden" name="subjectOfferingId" value="@Model.SelectedSubjectOfferingId" />
                <input type="hidden" name="examType" value="@Model.SelectedExamType" />
                <input type="hidden" name="assessmentComponent" value="@Model.SelectedAssessmentComponent" />
                <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                <input type="hidden" name="section" value="@Model.SelectedSection" />
                <input type="hidden" name="batch" value="@Model.SelectedBatch" />
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@T["Enter Result"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@T["Student"] <span class="text-danger">*</span></label>
                            <select aria-label="@T["Student"]" name="studentProfileId" class="form-select" required>
                                <option value="">@T["Select student…"]</option>
                                @foreach (var s in Model.Roster)
                                {
                                    <option value="@s.Id">@s.StudentName (@s.RegistrationNumber)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="resultType_select">@T["Result Type"] <span class="text-danger">*</span></label>
                            <select id="resultType_select" name="resultType" class="form-select" required>
                                <option value="Midterm">@T["Midterm"]</option>
                                <option value="Final">@T["Final"]</option>
                                <option value="Quiz">@T["Quiz"]</option>
                                <option value="Assignment">@T["Assignment"]</option>
                            </select>
                        </div>
                        <div class="row g-2">
                            <div class="col">
                                <label class="form-label">@T["Marks Obtained"] <span class="text-danger">*</span></label>
                                <input aria-label="@T["Marks Obtained"]" name="marksObtained" type="number" step="0.5" min="0" class="form-control" required />
                            </div>
                            <div class="col">
                                <label class="form-label">@T["Max Marks"] <span class="text-danger">*</span></label>
                                <input aria-label="@T["Max Marks"]" name="maxMarks" type="number" step="0.5" min="1" class="form-control" required />
                            </div>
                        </div>
                        @* Promote checkbox — hidden by default; shown by the JS below only when
                           Result Type is "Final". Promotion is only meaningful after a final exam. *@
                        <div id="promote_row" class="mt-3 d-none">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="promote" value="true" id="promoteCheck" />
                                <label class="form-check-label" for="promoteCheck">
                                    @T.Format("Promote student to next {0} after saving", periodLabel.ToLowerInvariant())
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@T["Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

