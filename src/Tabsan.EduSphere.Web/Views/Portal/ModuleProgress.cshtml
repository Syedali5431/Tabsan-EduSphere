@model Tabsan.EduSphere.Web.Models.Portal.ModuleProgressPageModel
@using Tabsan.EduSphere.Web.Models.Portal
@{
    ViewData["Title"] = T.Text("Module Progress");
    var r = Model.Report;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info" role="status">@T.Text(Model.Message)</div>
}

<div class="d-flex flex-wrap align-items-start gap-2 mb-3">
    <div class="me-auto">
        <h2 class="h3 mb-1">@T["Module Progress"]</h2>
        <p class="text-muted mb-0">@T["How far each student has worked through the course modules."]</p>
    </div>
    @if (Model.OfferingId != Guid.Empty) { <a asp-action="LmsManage" asp-route-offeringId="@Model.OfferingId" class="btn btn-sm btn-outline-secondary">@T["Manage modules"]</a> }
</div>

@if (!Model.IsConnected)
{
    <div class="border rounded p-3 bg-light">@T["API connection is not configured."]</div>
}
else
{
    <form method="get" asp-action="ModuleProgress" class="row g-2 align-items-end mb-3">
        <div class="col-md-6">
            <label class="form-label small" for="p-offering">@T["Course"]</label>
            <select id="p-offering" name="offeringId" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var o in Model.Offerings) { <option value="@o.Id" selected="@(o.Id == Model.OfferingId)">@o.Name</option> }
            </select>
        </div>
        <noscript><div class="col-md-2"><button class="btn btn-sm btn-outline-secondary">@T["Show"]</button></div></noscript>
    </form>

    @if (r is null)
    {
        <div class="border rounded p-3 bg-light" data-progress-empty>@(Model.Offerings.Count == 0 ? T.Text("You have no course offerings.") : T.Text("No progress to show."))</div>
    }
    else if (r.Modules.Count == 0)
    {
        <div class="border rounded p-3 bg-light" data-progress-empty>@T.Format("{0} has no published modules yet.", r.CourseCode)</div>
    }
    else
    {
        <div class="table-responsive border rounded mb-4">
            <table class="table table-sm align-middle mb-0" data-progress-table>
                <caption class="visually-hidden">@T.Format("Module progress by student in {0}", r.CourseCode)</caption>
                <thead class="table-light text-nowrap">
                    <tr>
                        <th scope="col">@T["Student"]</th>
                        <th scope="col" class="text-end">@T["Course"]</th>
                        @foreach (var m in r.Modules) { <th scope="col" class="text-center" title="@m.Title">@m.Title<div class="small fw-normal text-muted">@T.Format("{0} required", m.Required)</div></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in r.Students)
                    {
                        <tr class="@(Model.StudentId == s.StudentProfileId ? "table-active" : "")">
                            <th scope="row" class="fw-normal"><a asp-action="ModuleProgress" asp-route-offeringId="@r.CourseOfferingId" asp-route-studentId="@s.StudentProfileId">@s.Name</a> <span class="small text-muted">@s.RegistrationNumber</span></th>
                            <td class="text-end text-nowrap">
                                <div class="d-flex align-items-center gap-2 justify-content-end">
                                    <div class="progress" style="width: 5rem; height: .5rem;" role="progressbar" aria-label="@s.Name course progress" aria-valuenow="@s.CoursePercent" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @s.CoursePercent%"></div>
                                    </div>
                                    <span class="small">@s.CoursePercent%</span>
                                </div>
                            </td>
                            @foreach (var c in s.Modules)
                            {
                                <td class="text-center small" data-cell-status="@(c.Completed ? "done" : c.Locked ? "locked" : "todo")">
                                    @if (c.Completed) { <span class="text-success">✓</span> }
                                    else if (c.Locked) { <span aria-hidden="true">🔒</span><span class="visually-hidden">@T["Locked"]</span> }
                                    @(c.Required == 0 ? "" : $"{c.Done}/{c.Required}")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.StudentDetail is { } d)
        {
            <section class="card border-0 shadow-sm" aria-labelledby="detail-title" data-progress-detail>
                <div class="card-body">
                    <h3 class="h6" id="detail-title">@T.Format("{0} — {1}% of the course", (r.Students.FirstOrDefault(s => s.StudentProfileId == Model.StudentId)?.Name), d.CoursePercent)</h3>
                    @foreach (var m in d.Modules)
                    {
                        <div class="mt-3">
                            <div class="fw-semibold">@m.Title @(m.Completed ? "✓" : m.Locked ? $"🔒 {m.LockReason}" : $"{m.Done}/{m.Required}")</div>
                            <ul class="small mb-0">
                                @foreach (var i in m.Items.Where(i => i.ItemType != "Header"))
                                {
                                    <li>@i.Title — @(i.Status switch { "done" => "done", "todo" => "to do: " + ModuleItemText.Requirement(i.RequirementType, i.MinScorePercent), "locked" => "locked", _ => T.Text("no requirement") })</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </section>
        }
    }
}
