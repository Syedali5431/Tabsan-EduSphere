@model Tabsan.EduSphere.Web.Models.Portal.CourseMaterialStudentPageModel
@{
    ViewData["Title"] = T.Text("Course Materials");
    ViewData["PageTitle"] = T.Text("Course Materials");
    ViewData["ActivePage"] = "course_material";
    var periodLabel = T.Text(string.IsNullOrWhiteSpace(Model.PeriodFilterLabel) ? "Semester" : Model.PeriodFilterLabel); // Plan M11: vocabulary, then language
    var periodPlaceholder = string.IsNullOrWhiteSpace(Model.PeriodFilterPlaceholder) ? "All Semesters" : Model.PeriodFilterPlaceholder;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    var cls = Model.Message.StartsWith("Error") ? "alert-danger" : "alert-info";
    <div class="alert @cls alert-dismissible fade show" role="alert">
        @T.Text(Model.Message)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["Not connected."] <a asp-action="Dashboard">@T["Configure API"]</a>.</div>
}
else
{
    <section class="page-section-card card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="section-head mb-3">
                <div>
                    <span class="section-kicker">@T["Learning resources"]</span>
                    <h2 class="h5 mb-1">@T["Browse Course Materials"]</h2>
                    <p class="text-muted mb-0">@T["Find active files and links published by your faculty."]</p>
                </div>
            </div>

            <form method="get" asp-action="CourseMaterialStudent" class="row g-2 align-items-end filter-toolbar"
                  data-cascade-filter data-filter-role="@(User.IsInRole("SuperAdmin") ? "SuperAdmin" : User.IsInRole("Admin") ? "Admin" : "Student")">
                @* ── Student: only Class/Semester → Subject (pre-assigned Tenant/Campus/Dept/Program) ── *@
                <div class="col-md-4">
                    <label class="form-label">@periodLabel</label>
                    <select aria-label="@periodLabel" name="semesterId" class="form-select" onchange="this.form.submit()">
                        <option value="">@periodPlaceholder</option>
                        @foreach (var s in Model.Semesters)
                        {
                            <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@T["Subject/Course"]</label>
                    <select aria-label="@T["Subject/Course"]" name="courseId" class="form-select" onchange="this.form.submit()">
                        <option value="">@T["All Subjects"]</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.Id" selected="@(Model.SelectedCourseId == c.Id ? "selected" : null)">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">@T["Apply Filters"]</button>
                </div>
            </form>
        </div>
    </section>

    <div class="page-section-card card border-0 shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">@T["Available Materials"] <span class="badge bg-secondary ms-1">@Model.Materials.Count</span></h2>

            @if (Model.Materials.Count == 0)
            {
                <div class="empty-state-card">
                    <h3>@T["No materials available"]</h3>
                    <p class="text-muted mb-0">@T["Try selecting a different course filter."]</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var m in Model.Materials)
                    {
                        <div class="col-lg-6">
                            <article class="card h-100 border-0 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h3 class="h6 mb-0">@m.Title</h3>
                                        <span class="badge bg-info text-dark">@m.MaterialType</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <p class="small text-muted flex-grow-1">@m.Description</p>
                                    }
                                    else
                                    {
                                        <p class="small text-muted flex-grow-1">@T["No description provided."]</p>
                                    }

                                    <div class="d-flex gap-2 align-items-center mt-2">
                                        @if (!string.IsNullOrWhiteSpace(m.ExternalUrl))
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@m.ExternalUrl" target="_blank" rel="noopener">@T["Open Link"]</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(m.BlobPath))
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-action="DownloadCourseMaterialFile" asp-route-id="@m.Id" asp-route-returnTo="student">@T["Download File"]</a>
                                        }
                                    </div>

                                    <div class="small text-muted mt-3">@T.Format("Updated {0}", m.UpdatedAt.ToString("dd MMM yyyy"))</div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
