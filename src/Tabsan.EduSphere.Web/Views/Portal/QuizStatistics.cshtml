@model Tabsan.EduSphere.Web.Models.Portal.QuizStatisticsPageModel
@using Tabsan.EduSphere.Web.Models.Portal
@{
    var quiz = Model.Quiz;
    var s = Model.Stats;
    ViewData["Title"] = quiz is null ? "Quiz statistics" : $"Statistics — {quiz.Title}";
    string Num(decimal? v, string format = "0.##") => v.HasValue ? v.Value.ToString(format) : "—";
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="status">
        @T.Text(Model.Message)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}

@if (!Model.IsConnected || quiz is null || s is null)
{
    <div class="alert alert-warning">@T["Statistics could not be loaded."] <a asp-action="Quizzes">@T["Back to quizzes"]</a></div>
}
else
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <div class="flex-grow-1">
            <a asp-action="QuizBuilder" asp-route-quizId="@quiz.QuizId" class="small">@T["← Quiz builder"]</a>
            <h2 class="h4 mb-0 mt-1">@quiz.Title</h2>
        </div>
        <a class="btn btn-sm btn-outline-primary" asp-action="QuizGrading" asp-route-quizId="@quiz.QuizId">@T["Attempts &amp; grading"]</a>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var (label, value) in new[] {
            ("Finished attempts", s.CompletedAttempts.ToString()),
            ("Average", Num(s.MeanScore)),
            ("Median", Num(s.MedianScore)),
            ("Highest", Num(s.HighestScore)),
            ("Lowest", Num(s.LowestScore)),
            ("Std. deviation", Num(s.StandardDeviation)) })
        {
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
                    <div class="small text-muted">@label</div>
                    <div class="fs-4 fw-semibold">@value</div>
                </div></div>
            </div>
        }
    </div>
    <p class="small text-muted">@T.Format("Scores are out of {0}.", s.MaxScore.ToString("0.##")) <strong>@T["Difficulty"]</strong> @T["is the share of marks students earned (1.00 = everyone right)."] <strong>@T["Discrimination"]</strong> @T["compares the top 27% of attempts with the bottom 27%: above 0.3 is good, near 0 means the question doesn't separate strong and weak students, and a negative value usually means the question or its key needs checking."]</p>

    @if (s.CompletedAttempts == 0)
    {
        <div class="p-3 rounded border bg-light mb-3">@T["No finished attempts yet."]</div>
    }

    @foreach (var q in s.Questions.OrderBy(q => q.Order))
    {
        var warn = q.Discrimination is < 0;
        <section class="card border-0 shadow-sm mb-3 @(warn ? "border-start border-4 border-danger" : "")">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-3 align-items-start">
                    <div class="flex-grow-1" style="min-width: 14rem;">
                        <div class="small text-muted">@T.Format("#{0} · {1} · {2} marks · {3} response(s)", q.Order, QuizBuilderPageModel.TypeLabel(q.Type), q.Marks.ToString("0.##"), q.Responses)</div>
                        <div class="fw-semibold" style="white-space: pre-wrap;">@q.Text</div>
                    </div>
                    <dl class="row small mb-0 text-nowrap" style="min-width: 15rem;">
                        <dt class="col-7">@T["Difficulty"]</dt><dd class="col-5 mb-0">@Num(q.DifficultyIndex, "0.00")</dd>
                        <dt class="col-7">@T["Discrimination"]</dt><dd class="col-5 mb-0 @(warn ? "text-danger fw-semibold" : "")">@Num(q.Discrimination, "0.00")</dd>
                        <dt class="col-7">@T["Average marks"]</dt><dd class="col-5 mb-0">@Num(q.MeanMarks)</dd>
                    </dl>
                </div>

                @if (q.Options is { Count: > 0 })
                {
                    <div class="mt-2">
                        @foreach (var o in q.Options)
                        {
                            var pct = (double)(o.Share * 100);
                            <div class="d-flex align-items-center gap-2 small mb-1">
                                <div style="width: 40%;" class="text-truncate @(o.IsCorrect ? "fw-semibold text-success" : "")" title="@o.Text">@(o.IsCorrect ? "✓ " : "")@o.Text</div>
                                <div class="progress flex-grow-1" style="height: .75rem;" role="progressbar" aria-label="@o.Text" aria-valuenow="@pct.ToString("0")" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar @(o.IsCorrect ? "bg-success" : "bg-secondary")" style="width: @pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <div style="width: 5rem;" class="text-end">@o.Count (@pct.ToString("0")%)</div>
                            </div>
                        }
                    </div>
                }

                @if (quiz.Questions.Any(x => x.QuestionId == q.QuestionId))
                {
                    <form asp-action="RegradeQuizQuestion" method="post" class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="quizId" value="@quiz.QuizId" />
                        <input type="hidden" name="questionId" value="@q.QuestionId" />
                        <input type="hidden" name="returnTo" value="stats" />
                        <a class="btn btn-sm btn-link px-0" asp-action="QuizBuilder" asp-route-quizId="@quiz.QuizId" asp-fragment="q-@q.QuestionId">@T["Edit question"]</a>
                        <button class="btn btn-sm btn-outline-secondary" name="mode" value="Recalculate">@T["Regrade"]</button>
                        <button class="btn btn-sm btn-outline-secondary" name="mode" value="FullCredit" onclick="return confirm('@T.Js("Give every attempt full marks for this question?")');">@T["Full credit for all"]</button>
                    </form>
                }
            </div>
        </section>
    }
}
