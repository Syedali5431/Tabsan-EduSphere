@model Tabsan.EduSphere.Web.Models.Portal.ReportResultsPageModel
@{
    ViewData["Title"] = T.Text("Result Summary Report");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="ReportCenter" asp-controller="Portal" class="btn btn-sm btn-outline-secondary me-3" aria-label="@T["Report Center"]"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
        <div>
            <h2 class="mb-0"><i class="bi bi-clipboard-data me-2"></i>@T["Result Summary"]</h2>
            <small class="text-muted">@T["Marks and result breakdown per student per course"]</small>
        </div>
    </div>

    @if (!Model.IsConnected)
    {
        <div class="alert alert-warning"><i class="bi bi-wifi-off me-2"></i>@T["Not connected to API."]</div>
    }
    else
    {
        if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@T.Text(Model.Message)</div>
        }

        <form method="get" class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@T["Institute"]</label>
                        <select aria-label="@T["Institute"]" name="institutionType" class="form-select form-select-sm">
                            @if (!Model.InstitutionType.HasValue && Model.AvailableInstitutionTypes.Count > 1)
                            {
                                <option value="" selected>@T["All Institutes"]</option>
                            }
                            else if (Model.AvailableInstitutionTypes.Count > 1)
                            {
                                <option value="">@T["All Institutes"]</option>
                            }
                            @foreach (var institution in Model.AvailableInstitutionTypes)
                            {
                                <option value="@institution.Value" selected="@(Model.InstitutionType == institution.Value)">@institution.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">@T["Department"]</label>
                        <select aria-label="@T["Department"]" name="departmentId" class="form-select form-select-sm">
                            <option value="">@T["All Departments"]</option>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@DepartmentDisplayHelper.FormatLabel(d.Name, d.InstitutionType)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">@Model.PeriodFilterLabel</label>
                        <select aria-label="@Model.PeriodFilterLabel" name="semesterId" class="form-select form-select-sm">
                            <option value="">@Model.PeriodFilterPlaceholder</option>
                            @foreach (var s in Model.Semesters)
                            {
                                <option value="@s.Id" selected="@(Model.SemesterId == s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">@T["Course Offering"]</label>
                        <select aria-label="@T["Course Offering"]" name="offeringId" class="form-select form-select-sm">
                            <option value="">@T["All Offerings"]</option>
                            @foreach (var o in Model.Offerings)
                            {
                                <option value="@o.Id" selected="@(Model.OfferingId == o.Id)">@o.CourseCode — @o.CourseTitle</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">@T["Student"]</label>
                        <select aria-label="@T["Student"]" name="studentId" class="form-select form-select-sm">
                            <option value="">@T["All Students"]</option>
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.Id" selected="@(Model.StudentId == s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>@T["Filter"]</button>
                    </div>
                    @if (Model.Report is not null)
                    {
                        <div class="col-md-1">
                            <a href="@Url.Action("ExportResultSummary", "Portal", new { semesterId = Model.SemesterId, departmentId = Model.DepartmentId, offeringId = Model.OfferingId, studentId = Model.StudentId, institutionType = Model.InstitutionType })"
                               class="btn btn-success btn-sm w-100" title="@T["Export Excel"]"><i class="bi bi-file-earmark-excel me-1"></i><span>@T["Excel"]</span></a>
                        </div>
                        <div class="col-md-1">
                            <a href="@Url.Action("ExportResultSummaryCsv", "Portal", new { semesterId = Model.SemesterId, departmentId = Model.DepartmentId, offeringId = Model.OfferingId, studentId = Model.StudentId, institutionType = Model.InstitutionType })"
                               class="btn btn-outline-success btn-sm w-100" title="@T["Export CSV"]"><i class="bi bi-filetype-csv me-1"></i><span>CSV</span></a>
                        </div>
                        <div class="col-md-1">
                            <a href="@Url.Action("ExportResultSummaryPdf", "Portal", new { semesterId = Model.SemesterId, departmentId = Model.DepartmentId, offeringId = Model.OfferingId, studentId = Model.StudentId, institutionType = Model.InstitutionType })"
                               class="btn btn-outline-danger btn-sm w-100" title="@T["Export PDF"]"><i class="bi bi-filetype-pdf me-1"></i><span>PDF</span></a>
                        </div>
                    }
                </div>
            </div>
        </form>

        @if (Model.Report is not null)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">@T.Format("{0} record(s) &mdash; generated {1}", Model.Report.TotalRecords, Model.Report.GeneratedAt.ToString("dd MMM yyyy, HH:mm"))</span>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>@T["Reg. No."]</th>
                                    <th>@T["Student"]</th>
                                    <th>@T["Course"]</th>
                                    <th>@T["Title"]</th>
                                    <th>@T["Type"]</th>
                                    <th class="text-center">@T["Marks"]</th>
                                    <th class="text-center">@T["Max"]</th>
                                    <th class="text-center">%</th>
                                    <th class="text-center">GPA</th>
                                    <th>@T["Published"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Report.Rows)
                                {
                                    <tr>
                                        <td>@r.RegistrationNumber</td>
                                        <td>@r.StudentName</td>
                                        <td>@r.CourseCode</td>
                                        <td>@r.CourseTitle</td>
                                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@r.ResultType</span></td>
                                        <td class="text-center">@r.MarksObtained.ToString("F1")</td>
                                        <td class="text-center">@r.MaxMarks.ToString("F1")</td>
                                        <td class="text-center">@r.Percentage.ToString("F1")%</td>
                                        <td class="text-center">@(r.GradePoint.HasValue ? r.GradePoint.Value.ToString("F2") : "—")</td>
                                        <td>@(r.PublishedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary"><i class="bi bi-info-circle me-2"></i>@T["Select filters above and click Filter to generate the report."]</div>
        }
    }
</div>

<partial name="_ReportCascadeFilterScripts" />
