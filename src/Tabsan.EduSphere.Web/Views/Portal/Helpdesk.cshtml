@model Tabsan.EduSphere.Web.Models.Portal.HelpdeskListPageModel
@using Tabsan.EduSphere.Web.Models.Portal
@{
    ViewData["Title"] = "Support Tickets";
    var isStaff = Model.CallerRole is "SuperAdmin" or "Admin";
}

@if (TempData["Message"] is string msg)
{
    var cls = msg.StartsWith("Error") ? "alert-danger" : "alert-success";
    <div class="alert @cls alert-dismissible fade show" role="alert">
        @msg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Access-denied redirects (sidebar guard, Faculty/Admin-only and Finance-only section
   checks in PortalController.OnActionExecutionAsync, and the Dashboard SuperAdmin-only
   check) all land here for non-SuperAdmin users and explain why via "PortalMessage" -
   without this block that explanation was silently dropped, since it's the only key this
   view checked previously. *@
@if (TempData["PortalMessage"] is string portalMessage && !string.IsNullOrWhiteSpace(portalMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @portalMessage <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">Not connected. <a asp-action="Dashboard">Configure API</a>.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Helpdesk" asp-route-page="1" class="btn btn-sm @(Model.StatusFilter == null ? "btn-primary" : "btn-outline-secondary")">All</a>
            @foreach (var s in Enum.GetValues<TicketStatusWeb>())
            {
                <a asp-action="Helpdesk" asp-route-status="@((int)s)" asp-route-page="1"
                   class="btn btn-sm @(Model.StatusFilter == s ? "btn-primary" : "btn-outline-secondary")">
                    @s
                </a>
            }
        </div>
        <a asp-action="HelpdeskCreate" class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg me-1"></i>New Ticket
        </a>
    </div>

    @if (!Model.Tickets.Any())
    {
        <div class="alert alert-secondary">No tickets found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Submitted By</th>
                        @if (isStaff) { <th>Assigned To</th> }
                        <th>Created</th>
                        <th>Messages</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Tickets)
                    {
                        <tr>
                            <td class="fw-semibold">@t.Subject</td>
                            <td><span class="badge bg-secondary">@t.Category</span></td>
                            <td><partial name="_TicketStatusBadge" model="t.Status" /></td>
                            <td>@t.SubmitterName</td>
                            @if (isStaff)
                            {
                                <td>@(t.AssigneeName ?? "—")</td>
                            }
                            <td class="text-muted small">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                @if (t.MessageCount > 0)
                                {
                                    <span class="badge bg-info text-dark">@t.MessageCount</span>
                                }
                            </td>
                            <td>
                                <a asp-action="HelpdeskDetail" asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Helpdesk pagination" class="mt-3">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Helpdesk" asp-route-status="@(Model.StatusFilter is null ? null : (int)Model.StatusFilter.Value)" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Helpdesk" asp-route-status="@(Model.StatusFilter is null ? null : (int)Model.StatusFilter.Value)" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
}
