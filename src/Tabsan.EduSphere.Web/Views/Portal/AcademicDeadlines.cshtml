@model Tabsan.EduSphere.Web.Models.Portal.AcademicDeadlinesPageModel
@{ ViewData["Title"] = T.Text("Manage Deadlines"); }

@if (TempData["Message"] is string msg)
{
    var cls = msg.StartsWith("Error") ? "alert-danger" : "alert-success";
    <div class="alert @cls alert-dismissible fade show" role="alert">
        @T.Text(msg)
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-warning">@T.Text(Model.Message)</div>
}

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["Not connected."] <a asp-action="Dashboard">@T["Configure API"]</a>.</div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" asp-action="AcademicDeadlines" class="row g-2 align-items-end"
                  data-cascade-filter data-filter-role="@(User.IsInRole("SuperAdmin") ? "SuperAdmin" : User.IsInRole("Admin") ? "Admin" : User.IsInRole("Faculty") ? "Faculty" : "Student")">
                <div class="col-md-4">
                    <label class="form-label">@T["Filter by Semester"]</label>
                    <select aria-label="@T["Filter by Semester"]" name="semesterId" class="form-select" onchange="this.form.submit()">
                        <option value="">@T["All Semesters"]</option>
                        @foreach (var s in Model.Semesters)
                        {
                            <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createDeadlineModal">
                        <i class="fas fa-plus"></i> @T["Add Deadline"]
                    </button>
                </div>
                <div class="col-auto">
                    <a asp-action="AcademicCalendar" asp-route-semesterId="@Model.SelectedSemesterId"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-calendar"></i> @T["View Calendar"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">
                @T["Deadlines"]
                <span class="badge bg-secondary ms-1">@Model.Deadlines.Count</span>
            </h2>
            @if (Model.Deadlines.Count == 0)
            {
                <p class="text-muted">@T["No deadlines found. Add one using the button above."]</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@T["Semester"]</th>
                                <th>@T["Title"]</th>
                                <th>@T["Date"]</th>
                                <th>@T["Reminder"]</th>
                                <th>@T["Active"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Deadlines)
                            {
                                <tr>
                                    <td>@d.SemesterName</td>
                                    <td>@d.Title</td>
                                    <td>@d.DeadlineDate.ToString("dd MMM yyyy")</td>
                                    <td>@T.Format("{0} days before", d.ReminderDaysBefore)</td>
                                    <td>
                                        <span class="badge @(d.IsActive ? "bg-success" : "bg-secondary")">
                                            @(d.IsActive ? T.Text("Yes") : T.Text("No"))
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-xs btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editModal-@d.Id">
                                            @T["Edit"]
                                        </button>
                                        <form asp-action="DeleteDeadline" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <input type="hidden" name="semesterId" value="@Model.SelectedSemesterId" />
                                            <button type="submit" class="btn btn-xs btn-sm btn-outline-danger"
                                                    onclick="return confirm('@T.Js("Delete deadline {0}?", d.Title)')">@T["Del"]</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ── Create Modal ──────────────────────────────────────────────────────────────── *@
<div class="modal fade" id="createDeadlineModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="CreateDeadline" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="semesterId" value="@Model.SelectedSemesterId" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Add Deadline"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@T["Semester"] <span class="text-danger">*</span></label>
                        <select aria-label="@T["Semester"]" name="form.SemesterId" class="form-select" required>
                            <option value="">@T["Select semester…"]</option>
                            @foreach (var s in Model.Semesters)
                            {
                                <option value="@s.Id" selected="@(Model.SelectedSemesterId == s.Id ? "selected" : null)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T["Title"] <span class="text-danger">*</span></label>
                        <input aria-label="@T["Title"]" type="text" name="form.Title" class="form-control" required maxlength="200"
                               placeholder="@T["e.g. Census Date"]" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T["Description"]</label>
                        <textarea aria-label="@T["Description"]" name="form.Description" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T["Deadline Date"] <span class="text-danger">*</span></label>
                        <input aria-label="@T["Deadline Date"]" type="date" name="form.DeadlineDate" class="form-control" required
                               value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@T["Reminder Days Before"] <span class="text-danger">*</span></label>
                        <input aria-label="@T["Reminder Days Before"]" type="number" name="form.ReminderDaysBefore" class="form-control" min="0" max="30" required value="3" />
                        <div class="form-text">@T["Send reminder notification this many days before the deadline. 0 = day-of reminder only."]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@T["Create"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@* ── Edit Modals (one per deadline) ────────────────────────────────────────────── *@
@if (Model.IsConnected)
{
    @foreach (var d in Model.Deadlines)
    {
        <div class="modal fade" id="editModal-@d.Id" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="EditDeadline" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@d.Id" />
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@T["Edit Deadline"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">@T["Semester"]</label>
                                <select aria-label="@T["Semester"]" name="form.SemesterId" class="form-select" required>
                                    @foreach (var s in Model.Semesters)
                                    {
                                        <option value="@s.Id" selected="@(d.SemesterId == s.Id ? "selected" : null)">@s.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@T["Title"] <span class="text-danger">*</span></label>
                                <input aria-label="@T["Title"]" type="text" name="form.Title" class="form-control" required maxlength="200" value="@d.Title" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@T["Description"]</label>
                                <textarea aria-label="@T["Description"]" name="form.Description" class="form-control" rows="2" maxlength="1000">@d.Description</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@T["Deadline Date"] <span class="text-danger">*</span></label>
                                <input aria-label="@T["Deadline Date"]" type="date" name="form.DeadlineDate" class="form-control" required
                                       value="@d.DeadlineDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@T["Reminder Days Before"]</label>
                                <input aria-label="@T["Reminder Days Before"]" type="number" name="form.ReminderDaysBefore" class="form-control" min="0" max="30" value="@d.ReminderDaysBefore" />
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" name="form.IsActive" value="true"
                                       id="isActive-@d.Id" checked="@(d.IsActive ? "checked" : null)" />
                                <label class="form-check-label" for="isActive-@d.Id">@T["Active"]</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@T["Save"]</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
