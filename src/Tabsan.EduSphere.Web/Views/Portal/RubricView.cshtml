@* Final-Touches Phase 16 Stage 16.2 — Rubric grade view (student/faculty) *@
@model Tabsan.EduSphere.Web.Models.Portal.RubricViewPageModel
@{ ViewData["Title"] = T.Text("Rubric Grade"); }

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-info">@T.Text(Model.Message)</div> }

@if (!Model.IsConnected)
{
    <div class="alert alert-warning">@T["Not connected."] <a asp-action="Dashboard">@T["Configure API"]</a>.</div>
}
else if (Model.Grade is null)
{
    <div class="alert alert-info">@T["No rubric grade found for this submission."]</div>
}
else
{
    var grade = Model.Grade;
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header">
            <h6 class="mb-0">@grade.RubricTitle</h6>
        </div>
        <div class="card-body">
            <p class="mb-3">
                <strong>@T["Total Score:"]</strong>
                <span class="fs-5 fw-bold text-primary">@grade.TotalPoints / @grade.MaxTotalPoints</span>
            </p>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>@T["Criterion"]</th>
                            <th>@T["Level Chosen"]</th>
                            <th>@T["Points"]</th>
                            <th>@T["Max"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in grade.CriteriaResults)
                        {
                            <tr>
                                <td>@r.CriterionName</td>
                                <td>@(r.ChosenLabel ?? "-")</td>
                                <td>@r.PointsAwarded</td>
                                <td>@r.MaxPoints</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">@T["Total"]</td>
                            <td>@grade.TotalPoints</td>
                            <td>@grade.MaxTotalPoints</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
