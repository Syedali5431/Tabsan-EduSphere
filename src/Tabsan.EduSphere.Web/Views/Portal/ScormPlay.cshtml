@model Tabsan.EduSphere.Web.Models.Portal.ScormPlayerPageModel
@{
    ViewData["Title"] = Model.Title;
    var back = Model.IsStaff
        ? Url.Action("LmsManage", "Portal", new { offeringId = Model.OfferingId }) + "#scorm-packages"
        : $"/Portal/Scorm/{Model.PackageId}" + (Model.ModuleItemId is { } m ? $"?moduleItem={m}" : "");
}
@* Plan M13 — the SCORM player inside the portal: the package runs in the frame (its own page under /scorm/play/). *@
<div class="container-fluid py-2" data-scorm-page>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h1 class="h5 mb-0 me-auto">@Model.Title</h1>
        @if (Model.Mode == "review") { <span class="badge bg-secondary">@T["Review — nothing is recorded"]</span> }
        else if (Model.Mode == "preview") { <span class="badge bg-info text-dark">@T["Preview — nothing is recorded"]</span> }
        else { <span class="badge bg-light text-dark border">@T.Format("Attempt {0}", Model.AttemptNumber)</span> }
        <a class="btn btn-sm btn-outline-secondary" href="@back" data-scorm-exit>@T["Exit"]</a>
    </div>
    @* Not an .alert: site.js turns alerts present at load into toasts. *@
    <div class="border border-success rounded bg-success-subtle text-success-emphasis px-3 py-2 mb-2 d-none" data-scorm-finished role="status">
        @T["Your progress has been saved."] <a href="@back">@T["Back to the package"]</a>
    </div>
    @if (Model.Parts.Count(p => !p.IsHeading) > 1 || Model.Sequenced && Model.Parts.Count > 1)
    {
        var leaves = Model.Parts.Where(p => !p.IsHeading).ToList();
        // Sequenced packages open what the package delivers; others the first part not done that may be opened.
        var first = Model.Sequenced ? Model.Parts.FirstOrDefault(p => p.IsCurrent)
            : leaves.FirstOrDefault(p => p.Available && p.Status is not ("completed" or "passed" or "failed")) ?? leaves.FirstOrDefault(p => p.Available) ?? leaves.FirstOrDefault();
        <div class="row g-2" data-scorm-parts data-player-url="@Model.PlayerUrl" data-sequenced="@(Model.Sequenced ? "true" : "false")">
            <nav class="col-lg-3" aria-label="@T["Parts of this package"]">
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" data-scorm-prev>@T["Previous"]</button>
                    <button type="button" class="btn btn-sm btn-outline-primary flex-fill" data-scorm-next>@T["Next"]</button>
                </div>
                <p class="small border rounded px-2 py-1 mb-2 d-none" data-scorm-nav-message role="status"></p>
                @if (Model.Sequenced)
                {
                    <p class="small text-muted mb-2">@T["This package sets the order: Next opens what comes next, and parts open when the package allows."]</p>
                }
                <ul class="list-group small scorm-parts">
                    @foreach (var part in Model.Parts)
                    {
                        var indent = $"padding-inline-start: {0.75 + part.Depth}rem";
                        if (part.IsHeading)
                        {
                            <li class="list-group-item fw-semibold text-body-secondary bg-body-tertiary" style="@indent" data-heading>@part.Title</li>
                            continue;
                        }
                        var on = first is not null && part.Id == first.Id;
                        <li class="list-group-item d-flex justify-content-between align-items-start gap-2 @(on ? "active" : "")" style="@indent" data-part="@part.Id"
                            data-available="@(part.Available ? "true" : "false")" aria-current="@(on ? "step" : null)">
                            <button type="button" class="btn btn-link p-0 text-start flex-grow-1 text-reset text-decoration-none" data-part-open="@part.Id"
                                    disabled="@(!part.Available)" title="@(part.Reason is { } reason ? T.Text(reason).Replace("{0}", part.ReasonArg ?? "") : null)">@(part.Available ? "" : "🔒 ")@part.Title</button>
                            <span class="badge rounded-pill @(PartBadge(part.Status))" data-part-status>@T.Text(PartStatusText(part.Status))@(part.ScorePercent is { } s ? $" · {s:0.#}%" : "")</span>
                        </li>
                    }
                </ul>
            </nav>
            <div class="col-lg-9">
                <iframe class="scorm-frame" data-src="@(Model.Sequenced || first is null ? Model.PlayerUrl : Model.PlayerUrl + "?part=" + Uri.EscapeDataString(first.Id))" title="@Model.Title" allow="fullscreen; autoplay"></iframe>
            </div>
        </div>
    }
    else
    {
        <iframe class="scorm-frame" data-src="@Model.PlayerUrl" title="@Model.Title" allow="fullscreen; autoplay"></iframe>
    }
</div>
@functions {
    private static string PartBadge(string status) => status switch
    {
        "passed" or "completed" => "bg-success",
        "failed" => "bg-danger",
        "incomplete" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string PartStatusText(string status) => status switch
    {
        "passed" => "Passed",
        "failed" => "Failed",
        "completed" => "Completed",
        "incomplete" => "In progress",
        _ => "Not started"
    };
}
@section Scripts {
    <script src="~/js/scorm-page.js" asp-append-version="true"></script>
}
