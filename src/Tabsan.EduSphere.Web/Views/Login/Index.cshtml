@{
    ViewData["Title"] = "Login";
    Layout = null; // standalone page — no sidebar
    var error      = ViewData["Error"] as string;
    var returnUrl  = ViewData["ReturnUrl"] as string;
    var mfaEnabled = (ViewData["MfaEnabled"] as bool?) == true;
    var ssoEnabled = (ViewData["SsoEnabled"] as bool?) == true;
    var ssoProvider = ViewData["SsoProvider"] as string;
    var ssoLoginUrl = ViewData["SsoLoginUrl"] as string;
    var mfaPrivilegedOnly = (ViewData["MfaPrivilegedOnly"] as bool?) == true;
    var riskEnabled = (ViewData["SessionRiskEnabled"] as bool?) == true;
    var riskBlocking = (ViewData["SessionRiskBlocking"] as bool?) == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d6efd" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <title>Login — Tabsan EduSphere</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .auth-shell {
            position: relative;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1rem 1.5rem;
            overflow: hidden;
        }

        /* Slow-drifting accent orbs behind the auth card — purely decorative theme effect. */
        .auth-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(4px);
            pointer-events: none;
            z-index: -1;
            opacity: 0.55;
            animation: auth-orb-drift 22s ease-in-out infinite alternate;
        }

        .auth-orb-a {
            top: -8rem;
            left: -6rem;
            width: 26rem;
            height: 26rem;
            background: radial-gradient(circle, var(--color-primary-500), transparent 68%);
        }

        .auth-orb-b {
            bottom: -10rem;
            right: -8rem;
            width: 30rem;
            height: 30rem;
            background: radial-gradient(circle, var(--color-accent), transparent 70%);
            animation-delay: -6s;
            animation-duration: 26s;
        }

        @@keyframes auth-orb-drift {
            0%   { transform: translate(0, 0) scale(1); }
            50%  { transform: translate(2.5%, 3%) scale(1.06); }
            100% { transform: translate(-2%, -1.5%) scale(0.98); }
        }

        @@keyframes auth-card-in {
            from { opacity: 0; transform: translateY(14px) scale(0.985); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        @@keyframes auth-field-in {
            from { opacity: 0; transform: translateY(-6px); max-height: 0; }
            to   { opacity: 1; transform: translateY(0); max-height: 12rem; }
        }

        .login-card {
            width: 100%;
            max-width: 424px;
            animation: auth-card-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        .auth-brand {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .auth-brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border-radius: 18px;
            background: var(--btn-primary-bg);
            color: var(--color-white);
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 0.02em;
            margin-bottom: 0.9rem;
            box-shadow: 0 12px 28px rgba(26, 90, 160, 0.28);
        }

        .auth-brand h1 {
            font-family: var(--font-family-display);
            letter-spacing: -0.01em;
        }

        .auth-card {
            border-radius: var(--radius-lg);
            border: 1px solid var(--card-border);
            background: var(--card-bg);
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(14px);
        }

        .auth-card .card-body {
            padding: 2.25rem 2rem;
        }

        .auth-subhead {
            color: var(--color-slate-600);
            font-size: 0.92rem;
        }

        .auth-field-icon-group {
            position: relative;
        }

        .auth-field-icon-group .form-control {
            padding-left: 2.75rem;
        }

        .auth-field-icon {
            position: absolute;
            left: 0.95rem;
            top: 50%;
            transform: translateY(-50%);
            width: 1.15rem;
            height: 1.15rem;
            color: var(--color-slate-400);
            pointer-events: none;
        }

        .auth-field-icon svg {
            width: 100%;
            height: 100%;
        }

        .auth-toggle-visibility {
            position: absolute;
            right: 0.5rem;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: var(--color-slate-500);
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 0.75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .auth-toggle-visibility:hover {
            background: var(--color-slate-100);
            color: var(--color-slate-800);
        }

        .auth-toggle-visibility svg {
            width: 1.1rem;
            height: 1.1rem;
        }

        .mfa-field-wrap {
            animation: auth-field-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
            overflow: hidden;
        }

        .mfa-field-hint {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .mfa-field-hint svg {
            width: 0.95rem;
            height: 0.95rem;
            flex: none;
            color: var(--color-accent);
        }

        .auth-submit {
            position: relative;
        }

        .auth-submit .spinner-border {
            width: 1.05rem;
            height: 1.05rem;
            border-width: 0.15em;
        }

        .auth-divider-note {
            text-align: center;
            font-size: 0.8rem;
            color: var(--color-slate-500);
            margin-top: 1.5rem;
        }

        @@media (prefers-color-scheme: dark) {
            :root:not([data-theme]) {
                --body-bg: linear-gradient(180deg, #0b1220 0%, #131c2e 100%);
                --body-text: #e5edf7;
                --surface-overlay: rgba(15, 23, 42, 0.4);
                --bg-orb-1: rgba(34, 163, 197, 0.18);
                --bg-orb-2: rgba(96, 165, 250, 0.14);
                --card-bg: rgba(17, 25, 41, 0.92);
                --card-border: rgba(148, 163, 184, 0.2);
                --input-bg: rgba(15, 23, 42, 0.85);
                --input-text: #e5edf7;
            }

            :root:not([data-theme]) .auth-subhead { color: rgba(226, 232, 240, 0.72); }
            :root:not([data-theme]) .auth-divider-note { color: rgba(203, 213, 225, 0.6); }
            :root:not([data-theme]) .auth-toggle-visibility:hover { background: rgba(148, 163, 184, 0.16); color: #e5edf7; }
            :root:not([data-theme]) .form-control,
            :root:not([data-theme]) .form-select { background: var(--input-bg); color: var(--input-text); }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <span class="auth-orb auth-orb-a" aria-hidden="true"></span>
        <span class="auth-orb auth-orb-b" aria-hidden="true"></span>

        <div class="login-card px-3">
            <div class="auth-brand">
                <div class="auth-brand-mark">TE</div>
                <h1 class="h4 fw-bold mb-0">Tabsan EduSphere</h1>
                <p class="auth-subhead mb-0">Campus Portal</p>
            </div>

            <div class="card auth-card border-0">
                <div class="card-body">
                    <h2 class="h5 mb-1">Sign in to your account</h2>
                    <p class="auth-subhead mb-4">Enter your credentials to continue.</p>

                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <div class="alert alert-danger py-2 small mb-3" role="alert">@error</div>
                    }

                    @if (ssoEnabled)
                    {
                        <div class="alert alert-info py-2 small mb-3" role="alert">
                            Single sign-on is enabled@(string.IsNullOrWhiteSpace(ssoProvider) ? "" : $" ({ssoProvider})").
                            @if (!string.IsNullOrWhiteSpace(ssoLoginUrl))
                            {
                                <span> Use your organization's SSO entry point or <a href="@ssoLoginUrl" class="alert-link">continue via SSO</a>.</span>
                            }
                        </div>
                    }

                    @if (riskEnabled)
                    {
                        <div class="alert alert-warning py-2 small mb-3" role="alert">
                            Session risk monitoring is active@(riskBlocking ? " (high-risk sign-ins are blocked)." : ".")
                        </div>
                    }

                    <form method="post" asp-action="Index" asp-controller="Login" asp-route-returnUrl="@returnUrl" autocomplete="on" data-auth-form>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">Username</label>
                            <div class="auth-field-icon-group">
                                <span class="auth-field-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.14 0-8 2.15-8 5v1a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1c0-2.85-3.86-5-8-5Z" fill="currentColor"/></svg>
                                </span>
                                <input id="username" name="username" type="text" class="form-control"
                                       placeholder="e.g. superadmin" value="@(ViewData["Username"] as string)" autocomplete="username" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Password</label>
                            <div class="auth-field-icon-group">
                                <span class="auth-field-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M17 9V7a5 5 0 0 0-10 0v2a3 3 0 0 0-3 3v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7a3 3 0 0 0-3-3ZM9 7a3 3 0 0 1 6 0v2H9V7Z" fill="currentColor"/></svg>
                                </span>
                                <input id="password" name="password" type="password" class="form-control pe-5"
                                       placeholder="Your password" autocomplete="current-password" required data-password-input />
                                <button type="button" class="auth-toggle-visibility" data-toggle-password aria-label="Show password" title="Show password">
                                    <svg data-eye-open viewBox="0 0 24 24" fill="none"><path d="M12 5c-5.5 0-9.5 4.5-10 7 0.5 2.5 4.5 7 10 7s9.5-4.5 10-7c-0.5-2.5-4.5-7-10-7Zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9Z" fill="currentColor"/></svg>
                                    <svg data-eye-closed viewBox="0 0 24 24" fill="none" style="display:none;"><path d="M3 3l18 18M10.6 10.7a2.5 2.5 0 0 0 3.5 3.5M9.9 5.5A10.7 10.7 0 0 1 12 5c5.5 0 9.5 4.5 10 7-0.3 1.5-1.6 3.6-3.6 5.2M6.5 6.6C4.5 8 3.2 10 3 12c.5 2.5 4.5 7 10 7 1.2 0 2.3-.2 3.3-.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        </div>

                        @if (mfaEnabled)
                        {
                            <div class="mb-4 mfa-field-wrap">
                                <label for="mfaCode" class="form-label fw-semibold">Authenticator code</label>
                                <div class="auth-field-icon-group">
                                    <span class="auth-field-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 3.8 9.7 9 10 5.2-.3 9-5 9-10V6l-9-4Zm0 4a3 3 0 0 1 3 3v1h1a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h1V9a3 3 0 0 1 3-3Zm0 2a1 1 0 0 0-1 1v1h2V9a1 1 0 0 0-1-1Z" fill="currentColor"/></svg>
                                    </span>
                                    <input id="mfaCode" name="mfaCode" type="text" class="form-control"
                                           placeholder="6-digit code" inputmode="numeric" pattern="[0-9]*" maxlength="10"
                                           autocomplete="one-time-code" autofocus />
                                </div>
                                <div class="form-text mfa-field-hint">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 2 3 6v6c0 5 3.8 9.7 9 10 5.2-.3 9-5 9-10V6l-9-4Z" fill="currentColor"/></svg>
                                    <span>Enter the code from your authenticator app@(mfaPrivilegedOnly ? " (required for privileged roles)" : "").</span>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100 auth-submit" data-auth-submit>
                            <span data-auth-submit-label>Sign In</span>
                        </button>
                    </form>

                    <p class="auth-divider-note">Your session is protected and access is logged.</p>
                </div>
            </div>
        </div>
    </div>

    <footer class="tns-global-footer" role="contentinfo" style="width:100%;margin-top:auto;">
        <div class="tns-global-footer-inner">
            <div class="tns-global-footer-top">
                <a href="/" aria-label="Tabsan Nexora home">
                    <img src="/images/Logo.jpg" alt="Tabsan Nexora" class="tns-global-footer-logo">
                </a>
                <div class="tns-global-footer-brand">Tabsan Nexora</div>
            </div>
            <div class="tns-global-footer-tagline">Building the Next Era of Software</div>
            <div class="tns-global-footer-copy">&copy; 2026 Tabsan Nexora. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var toggleBtn = document.querySelector('[data-toggle-password]');
            var passwordInput = document.querySelector('[data-password-input]');
            if (toggleBtn && passwordInput) {
                toggleBtn.addEventListener('click', function () {
                    var isHidden = passwordInput.type === 'password';
                    passwordInput.type = isHidden ? 'text' : 'password';
                    toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
                    toggleBtn.setAttribute('title', isHidden ? 'Hide password' : 'Show password');
                    toggleBtn.querySelector('[data-eye-open]').style.display = isHidden ? 'none' : '';
                    toggleBtn.querySelector('[data-eye-closed]').style.display = isHidden ? '' : 'none';
                });
            }

            var form = document.querySelector('[data-auth-form]');
            var submitBtn = document.querySelector('[data-auth-submit]');
            var submitLabel = document.querySelector('[data-auth-submit-label]');
            if (form && submitBtn && submitLabel) {
                form.addEventListener('submit', function () {
                    if (submitBtn.disabled) {
                        return;
                    }
                    submitBtn.disabled = true;
                    submitLabel.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Signing in…';
                });
            }
        })();
    </script>
</body>
</html>
