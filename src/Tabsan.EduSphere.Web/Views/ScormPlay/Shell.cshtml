@model Tabsan.EduSphere.Web.Models.Portal.ScormShellModel
@{
    Layout = null;
    var config = System.Text.Json.JsonSerializer.Serialize(new { version = Model.Version, mode = Model.Mode, launchUrl = Model.LaunchUrl, cmi = Model.CmiJson,
        commitUrl = Model.CommitUrl, part = Model.PartId, sequenced = Model.Sequenced, nav = new { @continue = Model.CanContinue, previous = Model.CanPrevious } });
}
<!DOCTYPE html>
@* Plan M13 — the SCORM player shell: the runtime (window.API / window.API_1484_11) here, the package in the frame below. *@
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@Model.Title</title>
    <style>
        html, body { margin: 0; height: 100%; overflow: hidden; background: #fff; }
        iframe { border: 0; width: 100%; height: 100%; display: block; }
    </style>
    <script type="application/json" id="scorm-config">@Html.Raw(config)</script>
    @if (Model.Version == "SCORM 2004")
    {
        <script src="/lib/scorm-again/scorm2004.min.js"></script>
    }
    else
    {
        <script src="/lib/scorm-again/scorm12.min.js"></script>
    }
    <script src="/js/scorm-player.js" asp-append-version="true"></script>
</head>
<body>
    <iframe id="scorm-content" title="@Model.Title" allow="fullscreen; autoplay"></iframe>
</body>
</html>
