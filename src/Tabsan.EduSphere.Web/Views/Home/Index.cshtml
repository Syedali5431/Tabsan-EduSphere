@{
    ViewData["Title"] = T.Text("Welcome");
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <h1 class="display-6 fw-bold mb-3">@T["Tabsan EduSphere Portal"]</h1>
        <p class="text-muted mb-4">
            @T["Role-aware navigation is now scaffolded. Continue with timetable pages, building and room management,"]
            @T["and dashboard integrations in the next implementation phase."]
        </p>
        <a asp-controller="Portal" asp-action="Dashboard" class="btn btn-primary">@T["Open Dashboard Shell"]</a>
    </div>
</div>
